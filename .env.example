# Neon connection string. Leave empty to serve demo previews from fixtures/previews.
DATABASE_URL=

# Public base URL of the preview site, used in outreach emails.
PREVIEW_BASE_URL=https://heronscout-fe.vercel.app

# DeepSeek (OpenAI-compatible). Any other OpenAI-compatible API works by changing these three.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Sending mailbox. Gmail needs 2-step verification + an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_NAME=
SENDER_ADDRESS_LINE=


